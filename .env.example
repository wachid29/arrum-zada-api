# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arrum_zada
DB_USER=postgres
DB_PASSWORD=postgres

# CORS Allowed Origins (pisahkan dengan koma jika lebih dari satu)
