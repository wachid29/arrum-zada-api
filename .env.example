# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arrum_zada
DB_USER=postgres
DB_PASSWORD=postgres

# CORS Allowed Origins (pisahkan dengan koma jika lebih dari satu)
CORS_ALLOWED_ORIGINS=https://ifatich.github.io,http://localhost:3000,http://localhost:5173

# Rate Limiting & Anti-Bruteforce / Anti-Spam
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_SUBMIT_MAX=10

# Swagger & API Public Host Configuration (Opsional)
# Kosongkan agar Swagger otomatis mendeteksi alamat host VPS saat diakses
# Contoh: SWAGGER_SERVER_URL=https://api.domain.com atau http://103.xxx.xxx.xxx:3000
SWAGGER_SERVER_URL=
