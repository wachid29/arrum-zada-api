# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arrum_zada
DB_USER=postgres
DB_PASSWORD=postgres

# CORS Allowed Origins (pisahkan dengan koma jika lebih dari satu)
CORS_ALLOWED_ORIGINS=https://ifatich.github.io,http://localhost:3000,http://localhost:5173

# Rate Limiting & Anti-Bruteforce / Anti-Spam
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_SUBMIT_MAX=10
RATE_LIMIT_AUTH_MAX=20

# JWT Authentication
JWT_SECRET=arrum-zada-secret-key-change-in-production-2026
JWT_EXPIRES_IN=24h

# Swagger & API Public Host Configuration (Opsional)
# Kosongkan agar Swagger otomatis mendeteksi alamat host VPS saat diakses
# Contoh: SWAGGER_SERVER_URL=https://api.domain.com atau http://103.xxx.xxx.xxx:3000
SWAGGER_SERVER_URL=

# External API Integrations (Galeri 24 Gold Price)
GALERI24_HOST=https://galeri24.co.id
GALERI24_GOLD_PRICE_PATH=/api/gold-prices/daily-update
GOLD_PRICE_CACHE_TTL_MINUTES=10

# In-Memory Cache Configuration
QUESTIONS_CACHE_TTL_MINUTES=60

# HTTP Request Timeout & Logging Configuration
REQUEST_TIMEOUT_MS=30000
ENABLE_HTTP_LOGS=true
